# HDIMS local environment
# Copy this file to .env and replace placeholder values.

# LLM Provider Configuration
LLM_PROVIDER=openai  # set to "groq" to use Groq API

# OpenAI
OPENAI_API_KEY=your-openai-api-key

# Groq
GROQ_API_KEY=your-groq-api-key

# Model Overrides (defaults to gpt-4o if using OpenAI)
LLM_TEXT_MODEL=gpt-4o
LLM_VISION_MODEL=gpt-4o

# Database
DATABASE_URL=postgresql+psycopg://documed_user:documed_pass@localhost:5432/documed

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
REDIS_RESULT_BACKEND=redis://localhost:6379/1
USE_CELERY=False

# Product auth
SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=1440
JWT_REFRESH_EXPIRY_DAYS=7
RATE_LIMIT_STORAGE_URI=memory://

# File storage
STORAGE_PATH=./storage
MAX_FILE_SIZE_MB=50

# Vector storage (Qdrant)
# Option 1: Local / Docker Qdrant
# QDRANT_URL=http://localhost:6333
# QDRANT_STORAGE_PATH=./qdrant_storage

# Option 2: Qdrant Cloud
QDRANT_URL=https://your-cluster-id.us-east4-0.gcp.cloud.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-cloud-api-key

# File storage (S3-compatible via MinIO SDK / boto3)
STORAGE_BACKEND=minio

# Option 1: Local development (MinIO via Docker)
# MINIO_ENDPOINT=http://localhost:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=documents-storage

# Option 2: Supabase Cloud Storage (S3 Protocol)
# 1. Create a storage bucket in Supabase Dashboard -> Storage -> Buckets (e.g., documents-storage)
# 2. Get your S3 keys in Supabase Dashboard -> Project Settings -> Storage -> S3 Connection Keys
MINIO_ENDPOINT=https://your-project-id.supabase.co/storage/v1/s3
MINIO_ACCESS_KEY=your-supabase-s3-access-key-id
MINIO_SECRET_KEY=your-supabase-s3-secret-access-key
MINIO_BUCKET=documents-storage


# Frontend API base URL
VITE_API_URL=http://localhost:8000

GROQ_API_KEY=
